# Port the Midline server listens on
PORT=3001

# Directory where SQLite DB and uploaded photos are stored
DATA_DIR=./data

# Optional: Set explicitly when hosting behind HTTPS / reverse proxy for Passkeys
# Example: RP_ID=journal.midlinejournal.com
# Example: ORIGIN=https://journal.midlinejournal.com
# RP_ID=localhost
# ORIGIN=http://localhost:3001
# RP_NAME=Midline Journal

# Optional: Fixed secret for signing session cookies (auto-generated & persisted in DATA_DIR if omitted)
# SESSION_SECRET=
